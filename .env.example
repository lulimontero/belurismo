# Web chat + direct WebRTC voice. Server-side only: never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_SEARCH_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TURI_SESSION_SECRET=
APP_URL=https://belurismo.vercel.app

# Durable, encrypted account/session storage. Required for external account connections and Telegram.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth Web application. Callback: APP_URL/api/turi/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser-restricted Google Picker API key + numeric Cloud project number.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Telegram bot from BotFather, username without @. Webhook set by scripts/setup-telegram.mjs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Protects GET /api/turi/cron. Configure your scheduler explicitly before enabling background alerts.
CRON_SECRET=

# PENDING: validate actual Belo documentation before enabling tools.
# User-specific bearer tokens are entered in Conexiones, encrypted and stored per account.
BELO_MCP_URL=
BELO_MCP_TRANSPORT=http
# Exact, reviewed tool names only. All tools are disabled by default.
BELO_READ_TOOLS=
BELO_PREPARE_TOOLS=

# WhatsApp demo over Evolution API (Baileys). Webhook set by scripts/setup-whatsapp.mjs.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=turi
WHATSAPP_WEBHOOK_SECRET=
